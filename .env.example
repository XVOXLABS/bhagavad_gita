# ==============================================================================
# Bhagavad Gita AI Companion - Environment Configuration Template
# Copy this file to .env.local and fill in your keys. Never commit .env.local!
# ==============================================================================

# --- LLM API (Groq - Llama / GPT-OSS) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- Embeddings (Jina AI for 701 Sanskrit Verses Semantic Search) ---
JINA_API_KEY=your_jina_api_key_here
JINA_EMBED_MODEL=jina-embeddings-v4

# --- ElevenLabs: Natural Krishna Voice (TTS) & Scribe Dictation (STT) ---
# Optional: If omitted, the app automatically uses the browser's built-in voice & mic.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=iBRcUZbbi4hxPMzDCm71
ELEVENLABS_TTS_MODEL=eleven_v4
ELEVENLABS_STT_MODEL=scribe_v2

# --- Anam.ai: Interactive 3D Video Avatar (Optional) ---
ANAM_API_KEY=your_anam_api_key_here
ANAM_AVATAR_ID=your_anam_avatar_id_here
enableAudioPassthrough=true

# --- Supabase & Google Sign-In (Cloud Sync & Devotee Profiles) ---
# Obtain these from: https://supabase.com > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
