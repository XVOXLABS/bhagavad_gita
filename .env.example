# Copy to .env.local and set real keys. Never commit .env.local.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Jina embeddings for semantic verse search. Without a key the app falls back to keyword search.
# jina-embeddings-v4 is licensed for non-commercial research only; use jina-embeddings-v5-text-small
# for a commercial product and re-run `npm run embed` after changing it.
JINA_API_KEY=
JINA_EMBED_MODEL=jina-embeddings-v4
